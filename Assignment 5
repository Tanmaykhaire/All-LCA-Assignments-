import re

def check_string_regex(text):
    # ^ asserts the start of the string
    # [a-zA-Z0-9]+ matches one or more allowed characters
    # $ asserts the end of the string
    pattern = r"^[a-zA-Z0-9]+$"
    return bool(re.match(pattern, text))

# Test Cases
print(check_string_regex("ABCDEFabcdef123450"))  # True
print(check_string_regex("Python3"))             # True
print(check_string_regex("Hello World!"))        # False
print(check_string_regex("abc@123"))            # False
