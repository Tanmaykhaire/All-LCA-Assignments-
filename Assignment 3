def is_right_triangle(a, b, c):
    """
    Checks if three sides can form a right-angled triangle.
    Returns True if it is a right triangle, False otherwise.
    """
    # Combine the sides into a list and sort them in ascending order
    sides = [a, b, c]
    sides.sort()
    
    # sides[0] and sides[1] are the shorter legs, sides[2] is the hypotenuse
    # Apply the Pythagorean theorem: a^2 + b^2 == c^2
    if (sides[0]**2 + sides[1]**2) == sides[2]**2:
        return True
    else:
        return False

def main():
    print("--- Right-Angled Triangle Checker ---")
    try:
        # Prompt user to enter the lengths of the three sides
        side1 = float(input("Enter the length of the first side: "))
        side2 = float(input("Enter the length of the second side: "))
        side3 = float(input("Enter the length of the third side: "))
        
        # Side lengths must be greater than 0
        if side1 <= 0 or side2 <= 0 or side3 <= 0:
            print("Error: Side lengths must be positive numbers.")
            return

        # Call the function and display the result
        if is_right_triangle(side1, side2, side3):
            print(f"\nYes! A triangle with sides {side1}, {side2}, and {side3} is a right-angled triangle. ✅")
        else:
            print(f"\nNo. A triangle with sides {side1}, {side2}, and {side3} is NOT a right-angled triangle. ❌")
            
    except ValueError:
        print("Error: Please enter valid numerical values.")

# Run the main program
if __name__ == "__main__":
    main()
